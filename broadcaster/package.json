{
  "name": "laele-viewer",
  "productName": "laele viewer",
  "version": "1.0.0",
  "description": "Transmite sua tela para a atividade do Discord",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.laele.viewer",
    "productName": "laele viewer",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "style.css"
    ],
    "asarUnpack": [
      "node_modules/loopback-capture/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "laele viewer",
      "artifactName": "laele-viewer-setup-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "loopback-capture": "^5.0.0"
  }
}
