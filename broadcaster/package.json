{
  "name": "laele-viewer",
  "productName": "laele viewer",
  "version": "1.5.0",
  "description": "Transmite sua tela para a atividade do Discord",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "build": {
    "appId": "com.laele.viewer",
    "productName": "laele viewer",
    "files": [
      "build/icon.png",
      "log.js",
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "style.css"
    ],
    "asarUnpack": [
      "node_modules/loopback-capture/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "laele viewer",
      "artifactName": "laele-viewer-setup-${version}.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.video",
      "identity": "-",
      "artifactName": "laele-viewer-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "artifactName": "laele-viewer-${version}-linux-x64.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0"
  },
  "optionalDependencies": {
    "loopback-capture": "^5.0.0"
  }
}
